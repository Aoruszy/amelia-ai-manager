# Telegram user account
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=amelia_manager

# Admin
ADMIN_CHAT_ID=
TEST_ALLOWLIST_IDS=

# LLM - OpenAI Responses API by default; Gemini remains supported via LLM_PROVIDER=gemini
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_EXTRACTOR_ENABLED=true

# App
APP_ENV=development
COMPANY_PROFILE_NAME=amelia_flowers
DATABASE_URL=sqlite:///data/amelia_manager.sqlite3
LOG_LEVEL=INFO
AUTO_REPLY_ENABLED=false
ALLOW_ONLY_TEST_USERS=false

# Behavior
MIN_REPLY_DELAY_SECONDS=12
MAX_REPLY_DELAY_SECONDS=90
MESSAGE_BUFFER_SECONDS=20
CONVERSATION_HISTORY_LIMIT=20
CONVERSATION_MEMORY_DAYS=7
PII_RETENTION_DAYS=30
MAX_REPLY_CHARS=400
WORK_HOURS_START=09:00
WORK_HOURS_END=20:00
DELIVERY_HOURS_START=08:00
DELIVERY_HOURS_END=22:00
